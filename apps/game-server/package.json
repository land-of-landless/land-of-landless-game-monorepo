{
    "private": true,
    "name": "game-server",
    "version": "1.0.0",
    "description": "npm init template for bootstrapping an empty Colyseus project",
    "main": "build/index.js",
    "engines": {
        "node": ">= 23.11.0"
    },
    "scripts": {
        "start": "npx tsx src/index.ts",
        "dev": "npx tsx watch src/index.ts",
        "start:pm2": "npm run build && pm2 start -i 1 build/index.js",
        "worker:start": "tsx src/worker/index.ts",
        "worker:pm2": "pm2 start src/worker/index.ts --name profile-worker",
        "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
        "build": "npm run clean && tsc",
        "clean": "npx rimraf build",
        "test": "mocha -r tsx test/**_test.ts --exit --timeout 15000",
        "redis:local:start": "redis-stack-server --port 6380",
        "redis:local:stop": "redis-cli -p 6380 shutdown",
        "ci:local": "NODE_ENV=test AUTH_SALT=dummy SESSION_SECRET=dummy JWT_SECRET=test_secret_key_for_development_only HELIO_API_KEY=dummy HELIO_DYNAMIC_PAY_LINK=dummy HELIO_GLOBAL_WEBHOOK_SECRET=dummy HELIO_DYNAMIC_PAY_LINK_CALLBACK_URL=dummy GOOGLE_CLIENT_ID=dummy GOOGLE_CLIENT_SECRET=dummy REDIS_DB_PASS=khTpot9LGDvsEemDCHsmGnL4B117dmdO REDIS_DB_USER=default REDIS_DB_HOST=127.0.0.1 REDIS_DB_PORT=6380 npm run test",
        "prepare": "test \"$HUSKY\" = \"true\" || npx husky",
        "type-check": "tsc --noEmit",
        "prettier": "prettier --write --ignore-unknown"
    },
    "lint-staged": {
        "**/*.{ts,js,json,md}": [
            "prettier --write"
        ]
    },
    "author": "",
    "license": "UNLICENSED",
    "bugs": {
        "url": "https://github.com/colyseus/create-colyseus/issues"
    },
    "homepage": "https://github.com/colyseus/create-colyseus#readme",
    "devDependencies": {
        "@colyseus/loadtest": "^0.17.7",
        "@colyseus/sdk": "^0.17.34",
        "@colyseus/testing": "^0.17.10",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/errorhandler": "^1.5.3",
        "@types/express": "^5.0.6",
        "@types/form-data": "^2.2.1",
        "@types/leo-profanity": "^1.5.5",
        "@types/lodash": "^4.17.13",
        "@types/mocha": "^10.0.1",
        "@types/morgan": "^1.9.9",
        "@types/winston": "^2.4.4",
        "express-routes-catalogue": "^1.1.0",
        "husky": "^9.1.7",
        "jiti": "^2.5.1",
        "lint-staged": "^16.2.7",
        "mocha": "^11.7.5",
        "prettier": "^3.8.1",
        "rimraf": "^6.1.3",
        "tsx": "^4.21.0",
        "typescript": "^5.0.4"
    },
    "dependencies": {
        "@colyseus/auth": "^0.17.8",
        "@colyseus/core": "^0.17.36",
        "@colyseus/loadtest": "^0.17.8",
        "@colyseus/monitor": "^0.17.7",
        "@colyseus/playground": "^0.17.10",
        "@colyseus/redis-driver": "^0.17.6",
        "@colyseus/redis-presence": "^0.17.6",
        "@colyseus/schema": "^4.0.14",
        "@colyseus/testing": "^0.17.11",
        "@colyseus/tools": "^0.17.19",
        "add": "^2.0.6",
        "axios": "^1.7.9",
        "compression": "^1.7.5",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-basic-auth": "^1.2.1",
        "express-merror": "^1.0.0",
        "express-validator": "^7.2.0",
        "form-data": "^4.0.5",
        "helmet": "^8.0.0",
        "iso-3166": "^4.4.0",
        "leo-profanity": "^1.9.0",
        "lodash": "^4.17.21",
        "mongodb": "^6.6.2",
        "mongoose": "^8.4.0",
        "morgan": "^1.10.0",
        "obscenity": "^0.4.6",
        "openai": "^6.22.0",
        "rate-limiter-flexible": "^9.1.1",
        "redis": "^4.7.1",
        "redis-om": "^0.4.7",
        "winston": "^3.19.0",
        "yuka": "^0.7.8",
        "zod": "^4.0.15"
    }
}
