#!/usr/bin/env bash

# Colors for better visibility
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo_yellow() { printf "${YELLOW}%s${NC}\n" "$1"; }
echo_red() { printf "${RED}%s${NC}\n" "$1"; }
echo_green() { printf "${GREEN}%s${NC}\n" "$1"; }

echo_yellow "🚀 Running pre-commit checks..."

# 1. Prevent committing secrets or sensitive files
echo_yellow "🔍 Checking for sensitive files..."
FORBIDDEN_FILES="\.env$|\.pem$|npm-debug\.log|yarn-error\.log"
STAGED_FILES=$(git diff --cached --name-only)

# Use || true to prevent early exit if grep fails to find a match
MATCHING_FILES=$(echo "$STAGED_FILES" | grep -E "$FORBIDDEN_FILES" || true)

if [ -n "$MATCHING_FILES" ]; then
  echo_red "❌ ERROR: You are trying to commit sensitive files:"
  printf "%s\n" "$MATCHING_FILES"
  echo_red "Please remove these files from the commit."
  exit 1
fi

# 2. Check for forbidden keywords in staged files
echo_yellow "🔍 Checking for forbidden keywords..."
FORBIDDEN_KEYWORDS="debugger|fit\(|fdescribe\("

# Filter staged files to only include JS/TS files for keyword search
JS_TS_FILES=$(echo "$STAGED_FILES" | grep -E "\.(ts|js|tsx|jsx)$" || true)

if [ -n "$JS_TS_FILES" ]; then
  # Check for forbidden keywords in the staged content of those files
  FOUND_KEYWORDS=$(echo "$JS_TS_FILES" | xargs grep -lE "$FORBIDDEN_KEYWORDS" 2>/dev/null || true)
  if [ -n "$FOUND_KEYWORDS" ]; then
    echo_red "❌ ERROR: Forbidden keyword found in staged files!"
    echo "$JS_TS_FILES" | xargs grep -nE "$FORBIDDEN_KEYWORDS"
    exit 1
  fi
fi

# 3. Type checking
echo_yellow "🔍 Type checking..."
npm run type-check || {
  echo_red "❌ Type checking failed!"
  exit 1
}

# 4. Linting and formatting staged files
echo_yellow "💅 Formatting staged files..."
npx lint-staged || {
  echo_red "❌ Formatting failed!"
  exit 1
}

echo_green "✅ All pre-commit checks passed!"

