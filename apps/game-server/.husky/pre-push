#!/usr/bin/env bash

# Function to stop Redis on exit
cleanup() {
  echo "🛑 Stopping Redis..."
  npm run redis:local:stop
}

echo "🔄 Running pre-push checks..."

# 1. Type checking (essential for TypeScript projects)
echo "🔍 Type checking..."
npx tsc --noEmit || exit 1

# 2. Formatting check (non-destructive)
echo "💅 Checking formatting..."
npx prettier --check . || exit 1

# 3. Build
echo "📦 Building project..."
npm run build || exit 1

# 4. Starting Redis in the background and running tests
echo "🧪 Starting Redis and running tests..."
npm run redis:local:start &
REDIS_PID=$!

# Ensure Redis is stopped regardless of test success or failure
trap cleanup EXIT

# Give Redis a moment to start
sleep 2

# Run tests using the local CI configuration
npm run ci:local || exit 1

echo "✅ Pre-push checks completed successfully!"
